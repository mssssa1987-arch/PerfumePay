let active=null;window.openClient=id=>{active=db.clients.find(c=>c.id===id);let sales=db.sales.filter(s=>s.clientId===id),h=`<h2>${esc(active.name)}</h2><p class="muted">${esc(active.phone||'Sem WhatsApp')}</p><button class="primary" onclick="newSale()">+ Nova venda fiada</button>`;sales.forEach(s=>{h+=`<hr><b>${esc(s.desc)} — ${money(s.total)}</b>`;s.installments.forEach((i,k)=>h+=`<div class="installment"><div class="row"><span>${k+1}/${s.installments.length} • ${money(i.value)}</span><span>${fmt(i.due)}</span></div><div class="row">${st(i)} ${i.paid?`<span class="muted">Pago ${fmt(i.paidAt)}</span>`:`<button class="small" onclick="showPix('${s.id}','${i.id}')">PIX</button><button class="small green" onclick="pay('${s.id}','${i.id}')">Recebido</button>`}</div></div>`)});$('view').innerHTML=h;viewDlg.showModal()};window.newSale=()=>{viewDlg.close();$('saleForm').reset();$('saleWho').textContent='Cliente: '+active.name;$('sDate').value=today();saleDlg.showModal()};
$('saleForm').onsubmit=e=>{e.preventDefault();let total=+$('sTotal').value,n=+$('sN').value,base=Math.floor(total/n*100)/100,last=Math.round((total-base*(n-1))*100)/100;db.sales.push({id:crypto.randomUUID(),clientId:active.id,desc:$('sDesc').value.trim(),total,price:total,cost:0,installments:Array.from({length:n},(_,k)=>({id:crypto.randomUUID(),value:k===n-1?last:base,due:addM($('sDate').value,k),paid:false}))});save();saleDlg.close();openClient(active.id)};
window.pay=(sid,iid)=>{let s=db.sales.find(x=>x.id===sid),i=s.installments.find(x=>x.id===iid);i.paid=true;i.paidAt=today();save();if(active)openClient(active.id)};
function crc(str){let c=0xffff;for(let i=0;i<str.length;i++){c^=str.charCodeAt(i)<<8;for(let j=0;j<8;j++)c=(c&0x8000)?((c<<1)^0x1021)&0xffff:(c<<1)&0xffff}return c.toString(16).toUpperCase().padStart(4,'0')}
function fld(id,v){return id+String(v.length).padStart(2,'0')+v}function pix(key,amount,name,city,tx){let mai=fld('00','BR.GOV.BCB.PIX');let m=fld('26',fld('00','BR.GOV.BCB.PIX')+fld('01',key));let add=fld('62',fld('05',tx.slice(0,25)));let body=fld('00','01')+fld('01','12')+m+fld('52','0000')+fld('53','986')+fld('54',amount.toFixed(2))+fld('58','BR')+fld('59',name.slice(0,25))+fld('60',city.slice(0,15))+add+'6304';return body+crc(body)}
window.showPix=(sid,iid)=>{let s=db.sales.find(x=>x.id===sid),i=s.installments.find(x=>x.id===iid),c=db.clients.find(x=>x.id===s.clientId),key=db.settings.pixKey;if(!key){alert('Cadastre sua chave PIX em Configurações.');return}let code=pix(key,i.value,db.settings.store||'PERFUMARIA',db.settings.city||'BRASIL',iid.replaceAll('-',''));let msg=`Olá, ${c.name}! Sua parcela de ${money(i.value)} vence em ${fmt(i.due)}. PIX Copia e Cola:\n${code}\nApós pagar, envie o comprovante.`;$('pixView').innerHTML=`<h2>PIX da parcela</h2><p><b>${money(i.value)}</b> • vencimento ${fmt(i.due)}</p><p class="muted">PIX Copia e Cola</p><div class="copy">${esc(code)}</div><div class="actions"><button class="primary" onclick="navigator.clipboard.writeText('${code}');alert('PIX copiado!')">Copiar PIX</button><button onclick="navigator.clipboard.writeText(${JSON.stringify(msg)});alert('Mensagem copiada!')">Copiar cobrança</button></div><p class="muted">Para QR Code, esta tela pode ser ampliada na próxima publicação do app com uma biblioteca de QR.</p>`;pixDlg.showModal()};
$('saveSettings').onclick=()=>{db.settings.store=$('storeName').value.trim()||'Perfumaria';db.settings.pixKey=$('pixKey').value.trim();db.settings.city=$('pixCity').value.trim()||'BRASIL';save();alert('Configurações salvas.')};$('storeName').value=db.settings.store;$('pixKey').value=db.settings.pixKey;$('pixCity').value=db.settings.city;render();
