const KEY='perfumaria_final_v1';let db=JSON.parse(localStorage.getItem(KEY)||'{"clients":[],"sales":[],"products":[],"settings":{"store":"Perfumaria","pixKey":"","city":""}}');const $=x=>document.getElementById(x),save=()=>{localStorage.setItem(KEY,JSON.stringify(db));render()},today=()=>new Date().toISOString().slice(0,10),money=n=>Number(n).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}),fmt=d=>new Date(d+'T12:00:00').toLocaleDateString('pt-BR');function esc(s){return String(s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}function addM(s,n){let d=new Date(s+'T12:00:00');d.setMonth(d.getMonth()+n);return d.toISOString().slice(0,10)}function st(i){return i.paid?'<span class="badge ok">Pago</span>':i.due<today()?'<span class="badge danger">Atrasada</span>':i.due===today()?'<span class="badge">Vence hoje</span>':'<span class="badge">Pendente</span>'}
function render(){let open=0,rec=0,late=0,profit=0,pend=[];db.sales.forEach(s=>{let cost=Number(s.cost||0);s.installments.forEach(i=>{if(i.paid)rec+=i.value;else{open+=i.value;pend.push({...i,sid:s.id,cid:s.clientId,desc:s.desc}) ;if(i.due<today())late+=i.value}});profit+=Number(s.price||s.total||0)-cost});$('open').textContent=money(open);$('received').textContent=money(rec);$('late').textContent=money(late);$('profit').textContent=money(profit);pend.sort((a,b)=>a.due.localeCompare(b.due));$('next').innerHTML=pend.slice(0,7).map(chargeHTML).join('')||'<div class="empty">Nenhum vencimento pendente.</div>';$('chargeList').innerHTML=pend.map(chargeHTML).join('')||'<div class="empty">Nenhuma cobrança pendente.</div>';let q=($('search').value||'').toLowerCase();$('clientList').innerHTML=db.clients.filter(c=>c.name.toLowerCase().includes(q)).map(c=>{let bal=0;db.sales.filter(s=>s.clientId===c.id).forEach(s=>s.installments.forEach(i=>{if(!i.paid)bal+=i.value}));return `<div class="client"><div><b>${esc(c.name)}</b><div class="muted">${esc(c.phone||'Sem WhatsApp')} • ${money(bal)} em aberto</div></div><button onclick="openClient('${c.id}')">Abrir</button></div>`}).join('')||'<div class="empty">Nenhum cliente.</div>';$('productList').innerHTML=db.products.map(p=>`<div class="product"><div><b>${esc(p.name)}</b><div class="muted">Venda ${money(p.price)} • Custo ${money(p.cost)} • Lucro ${money(p.price-p.cost)}</div></div><strong>Estoque: ${p.stock}</strong></div>`).join('')||'<div class="empty">Nenhum perfume cadastrado.</div>'}
function chargeHTML(i){let c=db.clients.find(x=>x.id===i.cid);return `<div class="charge"><div><b>${esc(c?.name||'Cliente')} — ${money(i.value)}</b><div class="muted">${esc(i.desc)} • ${fmt(i.due)} ${st(i)}</div></div><div><button class="small" onclick="showPix('${i.sid}','${i.id}')">PIX</button> <button class="small green" onclick="pay('${i.sid}','${i.id}')">Recebido</button></div></div>`}
document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.page').forEach(x=>x.classList.add('hidden'));$(b.dataset.t).classList.remove('hidden')});$('search').oninput=render;
$('newClient').onclick=()=>{$('clientForm').reset();clientDlg.showModal()};$('clientForm').onsubmit=e=>{e.preventDefault();db.clients.push({id:crypto.randomUUID(),name:$('cName').value.trim(),phone:$('cPhone').value.trim(),notes:$('cNotes').value.trim()});save();clientDlg.close()};
